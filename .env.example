# Settings for Docker Compose. `docker compose up` works without a .env file.
# To override a default, copy this file to .env and uncomment the line.

# APP_PORT=8000
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=3

# Django. With no secret key set, the container generates one at each start.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Truck durations = routing (car) durations x this factor
# TRUCK_TIME_FACTOR=1.15

# Seconds to wait for each provider request (raise these on a slow network)
# ROUTING_TIMEOUT=25
# WEATHER_TIMEOUT=25
# GEOCODING_TIMEOUT=8

# Requests allowed per client: all endpoints / analyze + heatmap combined
# THROTTLE_ANON=240/min
# THROTTLE_HEAVY=20/min

# Providers (defaults are free public endpoints; no API keys needed)
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com
# PHOTON_URL=https://photon.komoot.io
# UPSTREAM_USER_AGENT=weather-aware-truck-routing/1.0
